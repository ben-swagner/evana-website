---
import { sicherheit } from '../../data/fakten';
---
<section class="sektion sektion-mist">
  <div class="container raster">
    <div>
      <p class="eyebrow">Sicherheit</p>
      <h2>Für regulierte Bestände gemacht</h2>
      <p class="lead">Banken, Versicherer, KVGs und öffentliche Auftraggeber vertrauen EVANA ihre Dokumente an. Das sind die Gründe.</p>
      <a href="/sicherheit/" class="mehr">Alles zu Sicherheit und Zertifizierungen</a>
    </div>
    <dl class="liste">
      {sicherheit.map((s) => <div><dt>{s.titel}</dt><dd>{s.text}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .raster { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .lead { margin-top: 18px; }
  .mehr { display: inline-block; margin-top: 24px; font-weight: 600; }
  .liste { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0; }
  .liste div { padding: 20px 22px; background: var(--weiss); border-radius: 20px; }
  .liste dt { font-weight: 700; color: var(--headline); display: flex; align-items: center; gap: 10px; }
  /* Kleine EVANA-Dreiecke als Symbol, abwechselnd in den drei Markenfarben */
  .liste dt::before {
    content: ''; width: 16px; height: 14px; flex: none; background: var(--petrol);
    -webkit-mask: url('/brand/evana-dreieck.svg') center / contain no-repeat; mask: url('/brand/evana-dreieck.svg') center / contain no-repeat;
  }
  .liste div:nth-child(3n+2) dt::before { background: var(--magenta); }
  .liste div:nth-child(3n) dt::before { background: var(--orange); }
  .liste dd { margin: 4px 0 0 26px; font-size: .95rem; }
  @media (max-width: 900px) { .raster { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .liste { grid-template-columns: 1fr; } }
</style>
