---
const ebenen = [
  {
    titel: 'Als Plattform',
    produkt: 'EVA, EVANA 360, EVANA TDR',
    text: 'Ihr Team arbeitet direkt in EVANA: Dokumentenmanagement für den Bestand, Datenraum für Transaktionen und EVA für alle Fragen.',
    farbe: 'magenta',
  },
  {
    titel: 'Als Datenbasis für Ihre KI',
    produkt: 'MCP-Server',
    text: 'Claude, Copilot oder Ihr eigenes Modell greifen über den MCP-Server von EVANA auf Ihre strukturierte Dokumentenbasis zu.',
    farbe: 'orange',
  },
  {
    titel: 'Im Hintergrund',
    produkt: 'EVANA AI und Schnittstellen',
    text: 'EVANA liest Dokumente aus und befüllt Ihre Systeme automatisch, etwa SAP RE-FX, ERP oder CRM. Ihre Prozesse bleiben, wie sie sind.',
    farbe: 'petrol',
  },
];
---
<section class="sektion sektion-mist">
  <div class="container raster">
    <div class="kopf">
      <p class="eyebrow">Eine Plattform, drei Wege</p>
      <h2>So setzen Sie EVANA ein</h2>
      <p class="lead">
        Jede KI ist nur so gut wie die Datenbasis darunter. EVANA schafft diese Basis einmal und stellt sie
        dort bereit, wo Sie sie brauchen. Viele Kunden starten auf einer Ebene und kommen später auf die nächste.
      </p>
      <a href="/produkte/" class="btn btn-sekundaer">Plattform im Überblick</a>
    </div>

    <ol class="stapel">
      {ebenen.map((e) => (
        <li class={`ebene ${e.farbe}`}>
          <p class="produkt">{e.produkt}</p>
          <h3>{e.titel}</h3>
          <p>{e.text}</p>
        </li>
      ))}
      <li class="fundament">
        <span>Ihre Dokumente</span>
        <small>Mietverträge, Grundbuch, Gutachten, Protokolle, Pläne</small>
      </li>
    </ol>
  </div>
</section>

<style>
  .raster { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .kopf { margin-bottom: 0; }
  .kopf .btn { margin-top: 30px; }
  .stapel { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ebene { position: relative; background: var(--weiss); border-radius: var(--radius); padding: 22px 26px 22px 54px; box-shadow: var(--schatten); }
  .ebene::before { content: ''; position: absolute; left: 24px; top: 28px; width: 14px; height: 14px; border-radius: 50%; }
  .ebene.magenta::before { background: var(--magenta); }
  .ebene.orange::before { background: var(--orange); }
  .ebene.petrol::before { background: var(--petrol); }
  .ebene.orange { margin-left: 14px; }
  .ebene.petrol { margin-left: 28px; }
  .produkt { font-size: .82rem; font-weight: 700; color: var(--hilfsgrau); margin-bottom: 4px; }
  .ebene h3 { margin-bottom: 6px; }
  .ebene p:last-child { font-size: .97rem; }
  .fundament {
    margin-left: 42px; padding: 18px 26px; border-radius: var(--radius);
    background: var(--petrol-dunkel); color: var(--weiss); display: grid; gap: 2px;
  }
  .fundament span { font-weight: 700; font-size: 1.1rem; }
  .fundament small { color: #9fc3ca; font-size: .9rem; }
  @media (max-width: 900px) {
    .raster { grid-template-columns: 1fr; }
    .ebene.orange, .ebene.petrol, .fundament { margin-left: 0; }
  }
</style>
