---
import DemoAnsicht from '../DemoAnsicht.astro';
import { anwendungsfaelle } from '../../data/anwendungsfaelle';
---
<section class="sektion sektion-mist" id="anwendungsfaelle">
  <div class="container">
    <div class="kopf">
      <p class="eyebrow">Anwendungsfälle</p>
      <h2>Was Sie mit EVANA erledigen</h2>
      <p class="lead">Sechs Aufgaben, die heute in vielen Teams Stunden kosten. Wählen Sie eine aus und sehen Sie, wie sie mit EVANA aussieht.</p>
    </div>

    <div class="umschalter">
      <div class="tabs" role="tablist" aria-label="Anwendungsfälle">
        {anwendungsfaelle.map((a, i) => (
          <button
            role="tab"
            id={`tab-${a.slug}`}
            aria-controls={`panel-${a.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{a.tab}</button>
        ))}
      </div>

      {anwendungsfaelle.map((a, i) => (
        <article class="panel" role="tabpanel" id={`panel-${a.slug}`} aria-labelledby={`tab-${a.slug}`} hidden={i !== 0}>
          <h3>{a.titel}</h3>
          <p class="kurz">{a.kurz}</p>
          <div class="vergleich">
            <div><p class="vg-titel">Heute</p><p>{a.vorher}</p></div>
            <div><p class="vg-titel mit">Mit EVANA</p><p>{a.mitEvana}</p></div>
          </div>
          <DemoAnsicht demo={a.demo} />
          <div class="panel-fuss">
            <a href={`/anwendungsfaelle/${a.slug}/`} class="btn btn-sekundaer">Mehr zu diesem Anwendungsfall</a>
            <span class="beispiel-hinweis">Beispielhafte Darstellung</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.umschalter').forEach((wurzel) => {
    const tabs = Array.from(wurzel.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const waehle = (tab: HTMLButtonElement, fokus = false) => {
      tabs.forEach((t) => {
        const aktiv = t === tab;
        t.setAttribute('aria-selected', String(aktiv));
        t.tabIndex = aktiv ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !aktiv;
      });
      if (fokus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => waehle(tab));
      tab.addEventListener('keydown', (e) => {
        const schritt = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (schritt) { e.preventDefault(); waehle(tabs[(i + schritt + tabs.length) % tabs.length], true); }
      });
    });
  });
</script>

<style>
  .umschalter { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .tabs { display: grid; gap: 4px; position: sticky; top: 100px; }
  .tabs button {
    text-align: left; font: 600 1.05rem/1.3 var(--font); color: var(--hilfsgrau);
    background: none; border: 0; border-radius: 12px; padding: 12px 18px 12px 34px; cursor: pointer; position: relative;
  }
  .tabs button::before { content: ''; position: absolute; left: 16px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: transparent; }
  .tabs button:hover { color: var(--headline); }
  .tabs button[aria-selected='true'] { color: var(--petrol-dunkel); background: var(--weiss); box-shadow: var(--schatten-dokument); }
  .tabs button[aria-selected='true']::before { background: var(--orange); }

  .panel h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.15; }
  .kurz { margin-top: 12px; font-size: 1.1rem; max-width: 62ch; }
  .vergleich { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin: 28px 0 36px; font-size: .97rem; }
  .vg-titel { font-weight: 700; color: var(--hilfsgrau); margin-bottom: 6px; }
  .vg-titel.mit { color: var(--petrol); }
  .panel-fuss { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
  .panel-fuss .beispiel-hinweis { margin: 0; }

  @media (max-width: 900px) {
    .umschalter { grid-template-columns: 1fr; }
    .tabs { position: static; display: flex; overflow-x: auto; gap: 8px; padding-bottom: 6px; scrollbar-width: thin; }
    .tabs button { flex: none; border-radius: 999px; background: var(--weiss); padding: 10px 16px; font-size: .95rem; }
    .tabs button::before { display: none; }
    .tabs button[aria-selected='true'] { background: var(--petrol-dunkel); color: var(--weiss); border-radius: 999px; }
    .vergleich { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
