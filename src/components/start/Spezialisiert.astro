---
import { zahlen } from '../../data/fakten';
const zeilen = [
  {
    kriterium: 'Dokumente verstehen',
    allgemein: 'Liest Text, kennt aber die Eigenheiten von Grundbuchauszug, Gutachten oder Nachtrag nicht.',
    evana: `Erkennt über ${zahlen.dokumenttypen.replace('+', '')} Dokumenttypen der Immobilienwirtschaft mit ${zahlen.erkennungsrate} Erkennungsrate.`,
  },
  {
    kriterium: 'Menge',
    allgemein: 'Arbeitet mit den Dateien, die Sie in einen Chat laden.',
    evana: 'Arbeitet mit dem ganzen Bestand, auch mit Millionen Dokumenten über viele Objekte.',
  },
  {
    kriterium: 'Belege',
    allgemein: 'Die Herkunft einer Antwort lässt sich oft nur mühsam prüfen.',
    evana: 'Jede Antwort nennt Datei, Seite und Absatz im Original.',
  },
  {
    kriterium: 'Ordnung',
    allgemein: 'Dateien bleiben, wo sie gerade liegen.',
    evana: 'Ordnet jedes Dokument dem richtigen Objekt und der richtigen Gesellschaft zu.',
  },
  {
    kriterium: 'Rechte und Sicherheit',
    allgemein: 'Zugriff und Datenhaltung richten sich nach dem jeweiligen Anbieter.',
    evana: 'Rollen und Rechte bis auf Dokumentebene, ISO 27001, Hosting in der EU.',
  },
];
---
<section class="sektion">
  <div class="container">
    <div class="kopf">
      <p class="eyebrow">Warum spezialisiert</p>
      <h2>Immobiliendokumente brauchen mehr als eine allgemeine KI</h2>
      <p class="lead">
        Claude, ChatGPT und Copilot sind starke Werkzeuge. Ein Immobilienbestand stellt aber eigene Anforderungen
        an Menge, Struktur und Nachweisbarkeit. Genau dafür ist EVANA gebaut.
      </p>
    </div>

    <div class="tabelle" role="table" aria-label="Vergleich allgemeine KI-Assistenten und EVANA">
      <div class="zeile kopfzeile" role="row">
        <span role="columnheader"><span class="sr-only">Kriterium</span></span>
        <span role="columnheader">Allgemeine KI-Assistenten</span>
        <span role="columnheader" class="ev">EVANA</span>
      </div>
      {zeilen.map((z) => (
        <div class="zeile" role="row">
          <span role="rowheader" class="krit">{z.kriterium}</span>
          <span role="cell" class="allg">{z.allgemein}</span>
          <span role="cell" class="ev">{z.evana}</span>
        </div>
      ))}
    </div>

    <div class="bruecke">
      <img src="/brand/evana-icon.png" alt="" width="64" height="58" loading="lazy" />
      <p>
        <strong>Sie müssen sich trotzdem nicht entscheiden.</strong> Über den MCP-Server von EVANA arbeiten Claude,
        Copilot oder Ihr eigenes Modell direkt mit Ihrer strukturierten Dokumentenbasis.
        <a href="/anwendungsfaelle/ki-und-systeme-anbinden/">So funktioniert die Anbindung</a>
      </p>
    </div>
  </div>
</section>

<style>
  .kopf h2 { max-width: 22ch; }
  .tabelle { display: grid; gap: 8px; }
  .zeile { display: grid; grid-template-columns: 200px 1fr 1fr; border-radius: 20px; overflow: hidden; background: var(--mist); }
  .zeile > span { padding: 20px 24px; }
  .kopfzeile { background: none; }
  .kopfzeile > span { font-weight: 700; color: var(--hilfsgrau); padding-block: 4px; }
  .kopfzeile .ev { background: none; color: var(--petrol); }
  .krit { font-weight: 700; color: var(--headline); }
  .allg { color: var(--hilfsgrau); }
  .ev { background: var(--petrol-dunkel); color: var(--weiss); }

  .bruecke { display: flex; gap: 22px; align-items: center; margin-top: 40px; padding: 26px 30px; background: var(--tint-orange); border-radius: var(--radius); }
  .bruecke img { width: 56px; height: auto; flex: none; }
  .bruecke p { max-width: 78ch; }
  .bruecke strong { color: var(--headline); }
  .bruecke a { font-weight: 600; margin-left: 4px; }

  @media (max-width: 760px) {
    .kopfzeile { display: none; }
    .zeile { grid-template-columns: 1fr; }
    .zeile > span { padding: 12px 18px; }
    .krit { padding-top: 20px !important; }
    .allg::before { content: 'Allgemeine KI: '; font-weight: 700; }
    .zeile .ev::before { content: 'EVANA: '; font-weight: 700; color: var(--orange); }
    .bruecke { flex-direction: column; align-items: flex-start; }
  }
</style>
