---
import { kunden } from '../../data/fakten';
// Platzhalter: Bis die Logodateien vorliegen, stehen die Namen als Text im Grau der Logoleiste.
---
<section class="kunden" aria-labelledby="kunden-titel">
  <div class="container">
    <h2 id="kunden-titel">Mit EVANA arbeiten unter anderem</h2>
    <ul>{kunden.map((k) => <li>{k}</li>)}</ul>
  </div>
</section>

<style>
  .kunden { padding-block: 28px 44px; border-bottom: 1px solid var(--linie); }
  h2 { font-size: .95rem; font-weight: 600; color: var(--hilfsgrau); margin-bottom: 18px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 40px; }
  li { font-weight: 700; font-size: 1.15rem; color: #9aa4a6; letter-spacing: .01em; }
</style>
