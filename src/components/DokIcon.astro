  <path d="M16 1v7a2 2 0 0 0 2 2h7" fill="#fff" fill-opacity=".35" />
  <rect x="6" y="15" width="13" height="2" rx="1" fill="#fff" fill-opacity=".8" />
  <rect x="6" y="20" width="10" height="2" rx="1" fill="#fff" fill-opacity=".8" />
  <rect x="6" y="25" width="12" height="2" rx="1" fill="#fff" fill-opacity=".8" />
</svg>
