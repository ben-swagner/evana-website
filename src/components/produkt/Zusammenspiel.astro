---
// Zeigt, wie ein Produkt mit den übrigen Bausteinen der Plattform zusammenspielt.
import { produkte } from '../../data/fakten';
interface Props { aktuell: string; titel: string; lead?: string; nur?: string[]; rollen?: Record<string, string> }
const { aktuell, titel, lead, nur, rollen = {} } = Astro.props;
const liste = (nur ? nur.map((s) => produkte.find((p) => p.slug === s)) : produkte.filter((p) => p.slug !== aktuell)).filter(
  (p) => p !== undefined,
);
---
<section class="sektion sektion-mist">
  <div class="container">
    <div class="kopf">
      <p class="eyebrow">Die Plattform</p>
      <h2>{titel.split('\n').map((t, i) => <>{i > 0 && <br />}{t}</>)}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <ul class:list={['bausteine', { fuenf: liste.length === 5 }]}>
      {liste.map((p) => (
        <li>
          <a href={`/produkte/${p.slug}/`}>
            <span class="name">{p.name}</span>
            <span>{rollen[p.slug] ?? p.kurz}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bausteine { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .bausteine a {
    display: grid; gap: 8px; align-content: start; height: 100%; padding: 24px 26px;
    background: var(--weiss); border-radius: var(--radius); text-decoration: none; color: var(--text);
    box-shadow: var(--schatten); transition: transform .15s;
  }
  .bausteine a:hover { transform: translateY(-3px); }
  /* Fünf Karten: in einer Reihe, darunter drei plus zwei, mobil untereinander. So steht nie eine Karte allein. */
  .bausteine.fuenf { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .fuenf a { padding: 22px 20px; }
  @media (max-width: 1100px) { .bausteine.fuenf { grid-template-columns: repeat(6, minmax(0, 1fr)); } .fuenf li { grid-column: span 2; } .fuenf li:nth-child(n+4) { grid-column: span 3; } }
  @media (max-width: 760px) { .bausteine.fuenf { grid-template-columns: 1fr; } .fuenf li, .fuenf li:nth-child(n+4) { grid-column: auto; } }
  .name { font-weight: 700; font-size: 1.25rem; color: var(--petrol); }
</style>
