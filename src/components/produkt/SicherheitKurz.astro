---
// Kurzer Sicherheitsblock für Produktseiten mit Verweis auf /sicherheit/.
import { sicherheit } from '../../data/fakten';
interface Props { text?: string; zusatz?: string }
const {
  text = 'EVANA läuft in der EVANA Secure-Cloud auf Microsoft Azure, Ihre Daten bleiben in der EU. Die Plattform ist für Banken, Versicherer und KVGs mit aufsichtsrechtlichen Pflichten gebaut.',
  zusatz,
} = Astro.props;
const siegel = sicherheit.slice(0, 6);
---
<section class="sicherheit">
  <div class="container">
    <div class="karte">
      <div class="text">
        <p class="eyebrow">Sicherheit</p>
        <h2>Gebaut für regulierte Branchen</h2>
        <p>{text}</p>
        {zusatz && <p class="zusatz">{zusatz}</p>}
        <a href="/sicherheit/" class="btn btn-sekundaer">Sicherheit und Zertifizierungen</a>
      </div>
      <ul class="siegel">
        {siegel.map((s) => <li>{s.titel}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .sicherheit { padding-block: clamp(56px, 8vw, 104px); }
  .karte {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(28px, 5vw, 64px); align-items: center;
    background: var(--petrol-dunkel); color: #d6e6e9; border-radius: var(--radius-gross); padding: clamp(32px, 5vw, 64px);
  }
  h2 { color: var(--weiss); margin-bottom: 16px; font-size: clamp(1.6rem, 2.8vw, 2.3rem); }
  .eyebrow { color: #9fc3ca; }
  .zusatz { margin-top: 10px; }
  .btn { margin-top: 26px; color: var(--weiss); border-color: rgba(255,255,255,.55); }
  .btn:hover { background: var(--weiss); color: var(--petrol-dunkel); }
  .siegel { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .siegel li {
    display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 16px;
    background: rgba(255,255,255,.08); color: var(--weiss); font-weight: 600; font-size: .95rem; line-height: 1.25;
  }
  .siegel li::before { content: ''; flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--orange); }
  @media (max-width: 860px) { .karte { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .siegel { grid-template-columns: 1fr; } }
</style>
