---
// Rahmen für UI-Szenen: weiße Karte mit Kopfzeile auf Mist-Fläche. Optional mit Bildunterschrift (hinweis). Ohne Hinweis "Beispielhafte Darstellung", Entscheidung vom 27.10.2026.
interface Props { titel: string; meta?: string; class?: string; hinweis?: string }
const { titel, meta, class: klasse, hinweis } = Astro.props;
---
<figure class:list={['fenster', klasse]}>
  <div class="rahmen">
  <div class="leiste">
    <span class="punkte" aria-hidden="true"><i></i><i></i><i></i></span>
    <strong>{titel}</strong>
    {meta && <span class="meta">{meta}</span>}
  </div>
  <div class="inhalt"><slot /></div>
  </div>
  {hinweis && <figcaption class="beispiel-hinweis">{hinweis}</figcaption>}
</figure>

<style>
  .fenster { margin: 0; }
  .leiste {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 14px 20px;
    background: var(--tint-petrol); font-size: .88rem;
  }
  .punkte { display: inline-flex; gap: 6px; }
  .punkte i { width: 9px; height: 9px; border-radius: 50%; background: var(--weiss); }
  .leiste strong { color: var(--headline); }
  .meta { margin-left: auto; color: var(--petrol); font-weight: 600; }
  .rahmen { border-radius: var(--radius); overflow: hidden; background: var(--weiss); box-shadow: var(--schatten); }
  .inhalt { padding: clamp(18px, 3vw, 28px); }
  .fenster .beispiel-hinweis { margin-top: 12px; }
  @media (max-width: 560px) { .meta { margin-left: 0; width: 100%; } }
</style>
