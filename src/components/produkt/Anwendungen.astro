---
// Verlinkt passende Anwendungsfälle aus src/data/anwendungsfaelle.ts.
import { anwendungsfaelle } from '../../data/anwendungsfaelle';
interface Props { slugs: string[]; titel?: string; lead?: string; mist?: boolean }
const { slugs, titel = 'Passende Anwendungsfälle', lead, mist = false } = Astro.props;
const faelle = slugs.map((s) => anwendungsfaelle.find((a) => a.slug === s)).filter((a) => a !== undefined);
---
{faelle.length > 0 && (
  <section class:list={['sektion', { 'sektion-mist': mist }]}>
    <div class="container">
      <div class="kopf">
        <p class="eyebrow">Anwendungsfälle</p>
        <h2>{titel}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>
      <ul class:list={['faelle', { aufMist: mist }]}>
        {faelle.map((a) => (
          <li>
            <a href={`/anwendungsfaelle/${a.slug}/`}>
              <span class="tab">{a.tab}</span>
              <strong>{a.titel}</strong>
              <span class="kurz">{a.kurz}</span>
              <span class="weiter" aria-hidden="true">Anwendungsfall ansehen</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .faelle { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .faelle a {
    display: grid; gap: 10px; align-content: start; height: 100%; padding: 26px 28px;
    background: var(--mist); border-radius: var(--radius); text-decoration: none; color: var(--text);
    transition: background-color .15s, transform .15s;
  }
  .faelle.aufMist a { background: var(--weiss); box-shadow: var(--schatten); }
  .faelle a:hover { background: var(--tint-petrol); }
  .tab { justify-self: start; font-size: .76rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--petrol); background: var(--tint-petrol); border-radius: 999px; padding: 4px 12px; }
  .faelle.aufMist .tab { background: var(--mist); }
  strong { font-size: 1.2rem; line-height: 1.3; color: var(--headline); }
  .kurz { font-size: .96rem; }
  .weiter { margin-top: 6px; font-weight: 700; font-size: .9rem; color: var(--petrol); display: inline-flex; align-items: center; gap: 8px; }
  .weiter::after { content: ''; width: 8px; height: 8px; border-right: 2px solid currentColor; border-top: 2px solid currentColor; transform: rotate(45deg); }
</style>
