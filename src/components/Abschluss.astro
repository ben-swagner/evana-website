---
import { cta } from '../data/fakten';
interface Props { titel?: string; text?: string }
const {
  titel = 'Erleben Sie EVANA mit Ihren eigenen Dokumenten',
  text = 'In der Demo zeigen wir Ihnen an Ihren Beispielen, welche Arbeit EVANA Ihrem Team abnimmt. Die Demo ist in der Regel innerhalb eines Werktags vorbereitet.',
} = Astro.props;
---
<section class="abschluss">
  <div class="container">
    <div class="karte">
      <img class="zeichen" src="/brand/evana-icon.png" alt="" width="256" height="230" loading="lazy" />
      <img class="logo" src="/brand/evana-logo-weiss.png" alt="EVANA" width="160" height="40" loading="lazy" />
      <h2>{titel}</h2>
      <p class="lead">{text}</p>
      <div class="aktionen">
        <a href={cta.demo} class="btn btn-primaer">{cta.demoLabel}</a>
        <a href="/kontakt/" class="btn btn-sekundaer">Kontakt aufnehmen</a>
      </div>
      <p class="sprint">Sie möchten EVANA erst ausprobieren? Mit dem <a href="/roi-sprint/">ROI-Sprint</a> testen Sie EVANA 14 Tage mit Ihren eigenen Unterlagen.</p>
    </div>
  </div>
</section>

<style>
  .abschluss { padding-block: clamp(56px, 8vw, 104px); }
  .karte { position: relative; overflow: hidden; background: var(--petrol-dunkel); color: #d6e6e9; border-radius: var(--radius-gross); padding: clamp(36px, 6vw, 80px); }
  .logo { position: relative; width: 150px; height: auto; margin-bottom: 26px; }
  .zeichen { position: absolute; right: clamp(32px, 6vw, 80px); top: 50%; width: clamp(160px, 20vw, 260px); height: auto; transform: translateY(-50%); }
  h2 { color: var(--weiss); max-width: 20ch; position: relative; }
  @media (max-width: 1100px) { .zeichen { display: none; } }
  .lead { margin-top: 18px; position: relative; }
  .aktionen { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; position: relative; }
  .karte .btn-sekundaer { color: var(--weiss); border-color: rgba(255,255,255,.55); }
  .karte .btn-sekundaer:hover { background: var(--weiss); color: var(--petrol-dunkel); }
  .sprint { margin-top: 40px; font-size: .95rem; color: #9fc3ca; position: relative; max-width: 60ch; }
  .sprint a { color: var(--orange); font-weight: 600; }
</style>
