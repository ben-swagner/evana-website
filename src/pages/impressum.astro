---
import Recht from '../layouts/Recht.astro';
import { firma } from '../data/fakten';
---
<Recht title="Impressum | EVANA" description="Impressum und Anbieterkennzeichnung der EVANA AG, Saarbrücken." titel="Impressum" pfad={{ label: 'Impressum', href: '/impressum/' }}>
  <h2>Anbieter</h2>
  <p>{firma.name}<br />{firma.strasse}<br />{firma.plz} {firma.ort}<br />Deutschland</p>
  <p>Vertreten durch den Vorstand: {firma.ceo} (Vorsitzender)<br />Vorsitzender des Aufsichtsrates: {firma.aufsichtsratVorsitz}</p>
  <h2>Kontakt</h2>
  <p>Telefon: <a href={`tel:${firma.telefonLink}`}>{firma.telefon}</a><br />E-Mail: <a href={`mailto:${firma.emailInfo}`}>{firma.emailInfo}</a></p>
  <h2>Registereintrag</h2>
  <p>{firma.handelsregister}<br />Steuernummer: {firma.steuernummer}<br />USt-IdNr.: {firma.ustId}</p>
  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <p>{firma.ceo}<br />{firma.name}, {firma.strasse}, {firma.plz} {firma.ort}</p>
  <h2>Bildnachweise</h2>
  <p>Grafiken und Produktdarstellungen: {firma.name}.</p>
</Recht>
