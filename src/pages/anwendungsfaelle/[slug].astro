---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import DemoAnsicht from '../../components/DemoAnsicht.astro';
import Szene from '../../components/Szene.astro';
import Faq from '../../components/Faq.astro';
import Abschluss from '../../components/Abschluss.astro';
import EvaKatalog from '../../components/start/Eva.astro';
import { anwendungsfaelle, type Anwendungsfall } from '../../data/anwendungsfaelle';
import { produkte } from '../../data/fakten';
import { brotkrumen, faqSchema, nurGueltig } from '../../lib/schema';

export function getStaticPaths() {
  return anwendungsfaelle.map((a) => ({ params: { slug: a.slug }, props: { fall: a } }));
}
interface Props { fall: Anwendungsfall }
const { fall } = Astro.props;
const andere = anwendungsfaelle.filter((a) => a.slug !== fall.slug);
const referenzen = (await getCollection('referenzen'))
  // Nur Kundenprojekte. Technologiepartner wie MongoDB passen nicht unter die Überschrift.
  .filter((r) => r.data.anwendungsfaelle.includes(fall.slug) && r.data.branche !== 'Technologie')
  .sort((a, b) => Number(a.data.anonym) - Number(b.data.anonym))
  .slice(0, 3);
const produktLinks = fall.produkte.map((n) => ({ name: n, p: produkte.find((p) => p.name === n) }));
const pfad = [{ label: 'Anwendungsfälle', href: '/anwendungsfaelle/' }, { label: fall.tab, href: `/anwendungsfaelle/${fall.slug}/` }];
const szenenTitel: Record<string, string> = {
  router: 'Animation: Eingehende Dokumente werden automatisch dem richtigen Objekt zugeordnet',
  qa: 'Animation: EVA schreibt Antwortvorschläge auf Bieterfragen mit Quelle',
  mcp: 'Animation: Ihre KI fragt über den MCP-Server von EVANA',
  report: 'Interaktives Portfolio-Dashboard mit EVA',
};
const szenenHinweis: Record<string, string> = {
  router: '',
  qa: '',
  mcp: 'Tippen Sie auf eine KI, um den Abgleich neu zu starten.',
  report: 'Wählen Sie links ein Objekt aus oder fragen Sie EVA.',
};
---
<Basis
  title={fall.seo.title}
  description={fall.seo.description}
  schema={nurGueltig([brotkrumen(pfad), faqSchema(fall.faq ?? [])])}
>
  <Seitenkopf titel={fall.titel} lead={fall.kurz} pfad={[pfad[0]]} />

  <section class="sektion sektion-mist buehne">
    <div class="container">
      {fall.szene ? (
        <Szene name={fall.szene} titel={szenenTitel[fall.szene]} hinweis={szenenHinweis[fall.szene] || undefined} rahmen={fall.szene !== 'report' && fall.szene !== 'mcp'} />
      ) : (
        <>
          <DemoAnsicht demo={fall.demo} />
        </>
      )}
    </div>
  </section>

  <section class="sektion">
    <div class="container zwei">
      <div class="karte heute">
        <h2>Ohne EVANA</h2>
        <p>{fall.vorher}</p>
      </div>
      <span class="vs" aria-hidden="true">vs</span>
      <div class="karte mit">
        <h2>Mit EVANA</h2>
        <p>{fall.mitEvana}</p>
      </div>
    </div>
    <div class="container">
      <dl class="details">
        {fall.details.map((d) => <div><dt>{d.titel}</dt><dd>{d.text}</dd></div>)}
      </dl>
    </div>
  </section>

  {fall.fragen && (
    <section class="sektion sektion-mist">
      <div class="container">
        <div class="kopf">
          <p class="eyebrow">Beispiele</p>
          <h2>Was EVA jeden Tag für Sie erledigt</h2>
          <p class="lead">Sie stellen EVA eine Frage oder geben ihr eine Aufgabe, so wie Sie es bei einer Kollegin tun würden. EVA arbeitet mit Ihren Dokumenten und nennt die Fundstelle.</p>
        </div>
        <ul class="fragen">{fall.fragen.map((f) => <li>{f}</li>)}</ul>
      </div>
    </section>
  )}

  {fall.schritte && (
    <section class="sektion">
      <div class="container">
        <div class="kopf">
          <p class="eyebrow">So funktioniert es</p>
          <h2>Von der Aufgabe zum belegten Ergebnis</h2>
        </div>
        <ol class="schritte">{fall.schritte.map((s) => <li><strong>{s.titel}</strong><p>{s.text}</p></li>)}</ol>
      </div>
    </section>
  )}

  {fall.slug === 'dokumente-befragen' && <EvaKatalog freigabe={false} />}

  {fall.abgrenzung && (
    <section class="sektion">
      <div class="container abgrenzung">
        <div>
          <h2>{fall.abgrenzung.titel}</h2>
          <p>{fall.abgrenzung.text}</p>
        </div>
        <a href={fall.abgrenzung.link.href} class="btn btn-sekundaer">{fall.abgrenzung.link.label}</a>
      </div>
    </section>
  )}

  {fall.referenz && (
    <section class="sektion auf-dunkel">
      <div class="container referenz">
        <p class="eyebrow">Aus der Praxis</p>
        <h2>{fall.referenz.name}</h2>
        <p class="lead">{fall.referenz.ergebnis}</p>
      </div>
    </section>
  )}

  {referenzen.length > 0 && (
    <section class="sektion">
      <div class="container">
        <h2 class="t">So setzen Kunden EVANA dafür ein</h2>
        <ul class="refs">
          {referenzen.map((r) => (
            <li><a href={`/referenzen/${r.id}/`}><span>{r.data.anonym ? r.data.branche : r.data.kunde}</span><strong>{r.data.titel}</strong></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="sektion sektion-mist">
    <div class="container meta">
      <div class="meta-karte">
        <h2 class="klein">Für diese Teams gemacht</h2>
        <ul class="teams">{fall.fuerWen.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="meta-karte">
        <h2 class="klein">Diese Produkte nutzen Sie dafür</h2>
        <ul class="produkte">
          {produktLinks.map(({ name, p }) => (
            <li>{p ? <a href={`/produkte/${p.slug}/`}><strong>{name}</strong><span>{p.kurz}</span></a> : <strong>{name}</strong>}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Faq eintraege={fall.faq ?? []} hell />

  <section class="sektion">
    <div class="container weitere">
      <h2 class="t">Weitere Anwendungsfälle</h2>
      <ul>{andere.map((a) => <li><a href={`/anwendungsfaelle/${a.slug}/`}><strong>{a.tab}</strong><span>{a.titel}</span></a></li>)}</ul>
    </div>
  </section>

  <Abschluss />
</Basis>

<style>
  .buehne { padding-block: clamp(40px, 6vw, 80px); }
  .zwei { display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: stretch; }
  .vs { align-self: center; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--orange); color: var(--weiss); font-weight: 700; font-size: 1.05rem; box-shadow: 0 0 0 6px rgba(245,158,52,.18); }
  .karte { border-radius: var(--radius); padding: clamp(24px, 3vw, 36px); }
  .karte h2 { font-size: 1.4rem; margin-bottom: 12px; }
  .heute { background: var(--mist); }
  .heute h2 { color: var(--hilfsgrau); }
  .mit { background: var(--petrol-dunkel); color: #d6e6e9; }
  .mit h2 { color: var(--orange); }
  .details { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 14px 0 0; }
  .details div { background: var(--mist); border-radius: var(--radius); padding: 24px 26px; }
  .details dt { font-weight: 700; color: var(--headline); font-size: 1.1rem; margin-bottom: 6px; }
  .details dd { margin: 0; }

  .fragen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .fragen li { background: var(--weiss); border-radius: 18px 18px 18px 4px; padding: 18px 20px; font-weight: 600; color: var(--headline); line-height: 1.4; box-shadow: var(--schatten-dokument); }
  .schritte { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; counter-reset: s; }
  .schritte li { counter-increment: s; background: var(--mist); border-radius: var(--radius); padding: 24px; }
  .schritte li::before { content: counter(s); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--orange); color: var(--weiss); font-weight: 700; margin-bottom: 14px; }
  .schritte strong { display: block; color: var(--headline); font-size: 1.1rem; margin-bottom: 6px; }
  .schritte p { font-size: .97rem; }

  .abgrenzung { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--tint-orange); border-radius: var(--radius-gross); padding: clamp(26px, 4vw, 48px); }
  .abgrenzung h2 { font-size: 1.5rem; margin-bottom: 10px; }
  .abgrenzung p { max-width: 70ch; }

  .referenz .lead { margin-top: 14px; }
  .t { font-size: 1.6rem; margin-bottom: 20px; }
  .refs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .refs a { display: grid; gap: 6px; padding: 22px 24px; border-radius: 20px; background: var(--mist); text-decoration: none; color: var(--headline); height: 100%; }
  .refs a:hover { background: var(--tint-petrol); }
  .refs span { font-size: .85rem; font-weight: 700; color: var(--petrol); }

  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
  .meta-karte { background: var(--weiss); border-radius: var(--radius); padding: clamp(24px, 3vw, 36px); }
  .klein { font-size: 1.2rem; margin-bottom: 16px; }
  .teams { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .teams li { position: relative; padding: 12px 16px 12px 40px; border-radius: 14px; background: var(--mist); font-weight: 600; color: var(--headline); }
  .teams li::before { content: ''; position: absolute; left: 16px; top: 50%; width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; background: var(--orange); }
  .produkte { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .produkte li > a, .produkte li > strong { display: grid; gap: 2px; padding: 12px 16px; border-radius: 14px; background: var(--tint-petrol); text-decoration: none; }
  .produkte strong { color: var(--petrol-dunkel); }
  .produkte span { font-size: .92rem; color: var(--text); }
  .produkte a:hover { background: var(--mist); }
  /* Fünf Karten: in einer Reihe, darunter drei plus zwei, mobil untereinander. So steht nie eine Karte allein. */
  .weitere ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .weitere a { display: grid; gap: 4px; padding: 18px 20px; text-decoration: none; color: var(--text); background: var(--mist); border-radius: 18px; height: 100%; }
  .weitere a:hover { background: var(--tint-petrol); }
  .weitere strong { color: var(--petrol); }
  .weitere span { font-size: .92rem; }
  @media (max-width: 1100px) { .weitere ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } .weitere li { grid-column: span 2; } .weitere li:nth-child(n+4) { grid-column: span 3; } }
  @media (max-width: 1000px) { .fragen { grid-template-columns: 1fr 1fr; } .schritte { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .weitere ul { grid-template-columns: 1fr; } .weitere li, .weitere li:nth-child(n+4) { grid-column: auto; } }
  @media (max-width: 760px) { .vs { justify-self: center; } .zwei, .meta, .details, .fragen, .schritte { grid-template-columns: 1fr; } }
</style>
