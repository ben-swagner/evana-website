---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Faq from '../../components/Faq.astro';
import Szene from '../../components/Szene.astro';
import Abschluss from '../../components/Abschluss.astro';
import DokIcon from '../../components/DokIcon.astro';
import Definition from '../../components/produkt/Definition.astro';
import Anwendungen from '../../components/produkt/Anwendungen.astro';
import SicherheitKurz from '../../components/produkt/SicherheitKurz.astro';
import { cta } from '../../data/fakten';
import { brotkrumen, faqSchema, produktSchema, nurGueltig } from '../../lib/schema';

const pfad = [{ label: 'Produkt', href: '/produkte/' }, { label: 'Report', href: '/produkte/report/' }];

const definition = {
  kern: 'Der EVANA Report ist der Objektbericht in EVANA 360.',
  text: 'Er liest Stammdaten, veraltete Nachweise, Mängel aus Wartungs- und Prüfprotokollen, Kündigungen und Fristen direkt aus Ihren Dokumenten und zeigt alle Daten eines Objekts auf einer Seite. Zu jedem Befund sehen Sie die Quelle, die Daten lassen sich als CSV, Excel oder per API weitergeben.',
};

const stamm = [
  { label: 'Eigentümer', wert: 'Mitte Immobilien GmbH' },
  { label: 'Nutzungsart', wert: 'Büro' },
  { label: 'Adresse', wert: 'Lindenallee 12, Frankfurt' },
  { label: 'Baujahr / Sanierung', wert: '1998 / 2016' },
  { label: 'Mietfläche', wert: '8.450 m²' },
];

const kacheln = [
  {
    titel: 'Veraltete Dokumente', zahl: 3, ton: 'kritisch',
    zeilen: [['Energieausweis', 'abgelaufen seit 24 Monaten'], ['Grundbuchauszug', 'älter als 96 Monate'], ['Mieterliste', 'älter als 4 Monate']],
  },
  {
    titel: 'Mängel an Anlagen', zahl: 4, ton: 'handeln',
    zeilen: [['Brandmeldeanlage', '1 offener Mangel'], ['Personenaufzug', '1 offener Mangel'], ['Sprinkleranlage', '2 offene Mängel']],
  },
  {
    titel: 'Fristen und Kündigungen', zahl: 3, ton: 'handeln',
    zeilen: [['Mieterhöhung EG', 'möglich ab 01.11.2026'], ['Kanzlei Berger & Partner', 'Kündigung zum 31.12.2026'], ['Café Lindner', 'Festlaufzeit endet 31.03.2027']],
  },
];

// Weitere Reiter des klickbaren Objektberichts (Beispieldaten)
const dokumente = [
  { name: 'Energieausweis', stand: 'abgelaufen seit 24 Monaten', ton: 'kritisch', quelle: 'Energieausweis_2014.pdf' },
  { name: 'Grundbuchauszug', stand: 'älter als 96 Monate', ton: 'kritisch', quelle: 'Grundbuch_Blatt-4417.pdf' },
  { name: 'Mieterliste', stand: 'älter als 4 Monate', ton: 'handeln', quelle: 'Mieterliste_2026.xlsx' },
  { name: 'Brandschutzgutachten', stand: 'aktuell, 03/2025', ton: 'ok', quelle: 'Brandschutz_2025.pdf' },
  { name: 'Teilungserklärung', stand: 'aktuell', ton: 'ok', quelle: 'Teilungserklaerung.pdf' },
];
const anlagen = [
  { name: 'Brandmeldeanlage', stand: '1 offener Mangel, Prüfung fällig seit 01.09.2026', ton: 'kritisch', quelle: 'Pruefprotokoll_BMA_2025.pdf' },
  { name: 'Personenaufzug', stand: '1 offener Mangel, TÜV-Prüfung in 9 Tagen', ton: 'handeln', quelle: 'Pruefbericht_Aufzug.pdf' },
  { name: 'Sprinkleranlage', stand: '2 offene Mängel, nächste Wartung 01/2027', ton: 'handeln', quelle: 'Wartung_Sprinkler_Q3.pdf' },
  { name: 'Lüftungsanlage', stand: 'ohne Mängel, Wartung am 03.11.2026', ton: 'ok', quelle: 'Wartung_RLT_Q3.pdf' },
];
const vertraege = [
  { name: 'Kanzlei Berger & Partner', stand: 'Kündigung zum 31.12.2026', ton: 'kritisch', quelle: 'Kuendigung_Berger.pdf' },
  { name: 'Café Lindner', stand: 'Festlaufzeit endet 31.03.2027', ton: 'handeln', quelle: 'MV_Cafe_Lindner.pdf, § 3' },
  { name: 'Mieter EG', stand: 'Mieterhöhung möglich ab 01.11.2026', ton: 'handeln', quelle: 'MV_EG_Nachtrag-2.pdf, § 5' },
  { name: 'Praxis Dr. Haas', stand: 'Verlängerungsoption bis 30.06.2029', ton: 'ok', quelle: 'MV_Praxis_Haas.pdf, § 4' },
];
const historie = [
  { name: '13.10.2026', stand: 'Prüfprotokoll Brandmeldeanlage eingelesen, 1 Mangel erkannt', ton: 'ok', quelle: 'Document Router' },
  { name: '02.10.2026', stand: 'Kündigung Kanzlei Berger erkannt und Frist gesetzt', ton: 'ok', quelle: 'Posteingang' },
  { name: '15.09.2026', stand: 'Neue Mieterliste übernommen, 14 Mieteinheiten abgeglichen', ton: 'ok', quelle: 'Upload' },
];
const reiter = [
  { id: 'uebersicht', label: 'Übersicht' },
  { id: 'dokumente', label: 'Dokumente', liste: dokumente },
  { id: 'maengel', label: 'Mängel und Maßnahmen', liste: anlagen },
  { id: 'vertraege', label: 'Verträge und Mieter', liste: vertraege },
  { id: 'keyfacts', label: 'Key Facts' },
  { id: 'historie', label: 'Historie', liste: historie },
];
const keyFactsVoll = [
  { label: 'WALT', wert: '6,2 Jahre', quelle: '14 Mietverträge' },
  { label: 'Vermietungsquote', wert: '96 %', quelle: 'Mieterliste_2026.xlsx' },
  { label: 'Mietfläche', wert: '8.450 m²', quelle: 'Flaechenaufstellung.pdf' },
  { label: 'Grundbuch, Blatt', wert: '4417', quelle: 'Grundbuch_Blatt-4417.pdf' },
  { label: 'Baujahr / Sanierung', wert: '1998 / 2016', quelle: 'Verkehrswertgutachten.pdf' },
  { label: 'Energieeffizienz', wert: 'Klasse D', quelle: 'Energieausweis_2014.pdf' },
];
const statusText: Record<string, string> = { kritisch: 'kritisch', handeln: 'Handlungsbedarf', ok: 'in Ordnung' };

const ablage = ['Energieausweis.pdf', 'Wartung_BMA_Q3.pdf', 'Kündigung_Berger.pdf', 'Mieterliste_2026.xlsx', 'Prüfbericht_Aufzug.pdf'];

const befunde = [
  { art: 'Veraltetes Dokument', titel: 'Energieausweis', status: 'abgelaufen', ton: 'kritisch', text: 'Seit 24 Monaten abgelaufen, ausgestellt am 23.09.2014.', quelle: 'Energieausweis_2014.pdf' },
  { art: 'Prüfkataster', titel: 'Brandmeldeanlage', status: 'überfällig', ton: 'handeln', text: 'Prüfung fällig seit 01.09.2026, 1 offener Mangel.', quelle: 'Pruefprotokoll_BMA_2025.pdf' },
  { art: 'Kündigung', titel: 'Kanzlei Berger', status: 'in 2 Monaten', ton: 'ok', text: 'Das Mietverhältnis endet zum 31.12.2026.', quelle: 'Kuendigung_Berger.pdf' },
];

const bereiche = [
  { titel: 'Übersicht', text: 'Stammdaten des Objekts und alle Befunde mit Handlungsbedarf auf einer Seite.' },
  { titel: 'Dokumente', text: 'Welche Nachweise veraltet sind oder fehlen, etwa Energieausweis, Grundbuchauszug oder Mieterliste.' },
  { titel: 'Mängel und Maßnahmen', text: 'Offene Mängel an Anlagen, gelesen aus Wartungs- und Prüfprotokollen, mit dem nächsten Wartungstermin.' },
  { titel: 'Verträge und Mieter', text: 'Kündigungen, auslaufende Festlaufzeiten und mögliche Mieterhöhungen mit Datum.' },
  { titel: 'Key Facts', text: 'Kennzahlen wie WALT, Vermietungsquote oder Grundbuchblatt, jeweils mit Verweis auf die Quelle.' },
];

const keyFacts = [
  { label: 'WALT', wert: '6,2 Jahre' },
  { label: 'Vermietungsquote', wert: '96 %' },
  { label: 'Grundbuch, Blatt', wert: '4417' },
];

const wege = [
  { titel: 'Klassifizieren', text: 'EVANA erkennt Dokumenttypen automatisch.', href: '/produkte/evana-ai/' },
  { titel: 'Extrahieren', text: 'Inhalte werden zu strukturierten Daten.', href: '/anwendungsfaelle/daten-extrahieren/' },
  { titel: 'Report', text: 'Der Report zeigt alle Daten eines Objekts auf einen Blick.', href: '/produkte/report/', aktiv: true },
  { titel: 'Fragen an EVA', text: 'EVA beantwortet Fragen direkt aus Ihren Dokumenten.', href: '/produkte/eva/' },
  { titel: 'Datenraum', text: 'Transaktionen laufen sicher in EVANA TDR.', href: '/produkte/evana-tdr/' },
  { titel: 'Anbinden', text: 'Daten fließen per API in Ihre BI-Tools.', href: '/produkte/integrationen/' },
];

const faq = [
  { frage: 'Was ist der EVANA Report?', antwort: `${definition.kern} ${definition.text}` },
  { frage: 'Welche Informationen zeigt der Objektbericht?', antwort: 'Der Objektbericht zeigt die Stammdaten eines Objekts, veraltete Dokumente und Nachweise, offene Mängel an Anlagen aus Wartungs- und Prüfprotokollen, Kündigungen, Fristen und Key Facts wie WALT oder Vermietungsquote. Die Inhalte sind in Bereiche gegliedert: Übersicht, Dokumente, Mängel und Maßnahmen, Verträge und Mieter, Key Facts und Historie.' },
  { frage: 'Woher stammen die Daten im Report?', antwort: 'EVANA liest alle Angaben direkt aus Ihren eigenen Unterlagen, etwa aus Energieausweisen, Prüfprotokollen, Kündigungsschreiben oder Mieterlisten. Zu jedem Befund sehen Sie die Quelle und können ihn im Originaldokument prüfen.' },
  { frage: 'Bleibt der Report aktuell?', antwort: 'Ja. Neue Dokumente fließen automatisch in den Report ein. Auslaufende Verträge und fällige Prüfungen erscheinen, bevor sie kritisch werden, und der Bericht zeigt, wann er zuletzt aktualisiert wurde.' },
  { frage: 'Kann ich die Daten aus dem Report weiterverwenden?', antwort: 'Ja. Die Daten lassen sich als CSV oder Excel exportieren oder per API an Ihre weiteren Systeme übergeben, zum Beispiel an Ihre BI-Tools.' },
  { frage: 'Wie spielen Report und EVA zusammen?', antwort: 'Der Report zeigt auf einen Blick, wo es bei einem Objekt hakt. Mit der KI-Assistentin EVA werten Sie die Daten direkt weiter aus und stellen Rückfragen in normaler Sprache, mit Fundstelle zu jeder Antwort.' },
];

const schema = nurGueltig([
  produktSchema({ name: 'EVANA Report', beschreibung: `${definition.kern} ${definition.text}`, url: '/produkte/report/' }),
  faqSchema(faq),
  brotkrumen(pfad),
]);
---
<Basis
  title="Objektbericht: alle Daten auf einen Blick | EVANA Report"
  description="Der EVANA Report liest Nachweise, Mängel, Kündigungen und Fristen aus Ihren Dokumenten und zeigt alle Daten eines Objekts auf einer Seite."
  schema={schema}
>
  <Seitenkopf
    titel="Alle Daten eines Objekts auf einen Blick"
    lead="Der EVANA Report bündelt alles, was in Ihren Dokumenten zu einem Objekt steckt: veraltete Nachweise, offene Mängel, Kündigungen und Fristen. So sehen Sie auf einer Seite, wo es hakt, und zu jedem Befund die Quelle."
    pfad={pfad}
    zweitLink={{ label: 'Plattform im Überblick', href: '/produkte/' }}
  />

  <section class="buehne">
    <div class="container">
      <figure class="app">
        <div class="app-kopf">
          <span class="krume">EVANA 360 / Commercial / <strong>Bürohaus Mitte</strong></span>
          <span class="stand">Zuletzt aktualisiert: 13.10.2026, 15:38</span>
          <span class="knopf" aria-hidden="true">Aktualisieren</span>
        </div>
        <div class="app-koerper">
          <ul class="seitenmenue" aria-hidden="true">
            <li>Dashboard</li><li>Dokumente</li><li>Datenraum</li><li>Elemente</li><li class="aktiv">Objektbericht</li>
          </ul>
          <div class="bericht">
            <div class="bericht-titel">
              <h2>Objektbericht · Bürohaus Mitte</h2>
              <span class="ton handeln">Handlungsbedarf</span>
            </div>
            <div class="reiter" role="tablist" aria-label="Bereiche des Objektberichts">
              {reiter.map((r, i) => (
                <button type="button" role="tab" id={`tab-${r.id}`} aria-controls={`panel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{r.label}</button>
              ))}
            </div>
            <div class="panel" role="tabpanel" id="panel-uebersicht" aria-labelledby="tab-uebersicht">
              <dl class="stamm">
                {stamm.map((s) => <div><dt>{s.label}</dt><dd>{s.wert}</dd></div>)}
              </dl>
              <div class="kacheln">
                {kacheln.map((k, i) => (
                  <button type="button" class={`kachel ${k.ton}`} data-ziel={['dokumente', 'maengel', 'vertraege'][i]}>
                    <span class="kachel-kopf"><span class="kachel-titel">{k.titel}</span><span class="zahl">{k.zahl}</span></span>
                    <span class="kachel-liste">{k.zeilen.map(([a, b]) => <span class="zeile"><strong>{a}</strong><span>{b}</span></span>)}</span>
                    <span class="kachel-mehr">Details ansehen</span>
                  </button>
                ))}
              </div>
            </div>
            {reiter.filter((r) => r.liste).map((r) => (
              <div class="panel" role="tabpanel" id={`panel-${r.id}`} aria-labelledby={`tab-${r.id}`} hidden>
                <ul class="eintraege">
                  {r.liste!.map((e) => (
                    <li>
                      <strong>{e.name}</strong>
                      <span class="zustand">{e.stand}</span>
                      <span class={`ton ${e.ton}`}>{statusText[e.ton]}</span>
                      <span class="fundstelle">{e.quelle}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="panel" role="tabpanel" id="panel-keyfacts" aria-labelledby="tab-keyfacts" hidden>
              <dl class="kf">
                {keyFactsVoll.map((f) => <div><dt>{f.label}</dt><dd>{f.wert}</dd><span class="fundstelle">Quelle: {f.quelle}</span></div>)}
              </dl>
            </div>
            <button type="button" class="eva-zeile" aria-expanded="false" aria-controls="eva-antwort">
              <span class="knoten" aria-hidden="true"></span>
              <span class="eva-text"><strong>EVA</strong> Für Bürohaus Mitte sind 3 Nachweise veraltet und 4 Mängel an Anlagen offen.</span>
              <span class="fundstelle">Was ist zuerst zu tun?</span>
            </button>
            <div class="eva-antwort" id="eva-antwort" hidden>
              <p><strong>EVA:</strong> Am dringendsten ist die Prüfung der Brandmeldeanlage, sie ist seit dem 01.09.2026 fällig. Danach folgen die TÜV-Prüfung des Aufzugs in 9 Tagen und der Energieausweis, der seit 24 Monaten abgelaufen ist.</p>
              <span class="fundstelle">Pruefprotokoll_BMA_2025.pdf · S. 2</span>
              <span class="fundstelle">Pruefbericht_Aufzug.pdf · S. 1</span>
              <span class="fundstelle">Energieausweis_2014.pdf · S. 1</span>
            </div>
          </div>
        </div>
      </figure>
      <p class="beispiel-hinweis">Beispielhafte Darstellung. Klicken Sie sich durch die Reiter, die Kacheln und die Frage an EVA.</p>
    </div>
  </section>

  <script>
    const app = document.querySelector('.app');
    if (app) {
      const tabs = Array.from(app.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const waehle = (id: string, fokus = false) => {
        tabs.forEach((t) => {
          const aktiv = t.id === `tab-${id}`;
          t.setAttribute('aria-selected', String(aktiv));
          t.tabIndex = aktiv ? 0 : -1;
          const p = document.getElementById(t.getAttribute('aria-controls')!);
          if (p) p.hidden = !aktiv;
          if (aktiv && fokus) t.focus();
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => waehle(t.id.slice(4)));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (d) { e.preventDefault(); waehle(tabs[(i + d + tabs.length) % tabs.length].id.slice(4), true); }
        });
      });
      app.querySelectorAll<HTMLButtonElement>('[data-ziel]').forEach((k) => k.addEventListener('click', () => waehle(k.dataset.ziel!, true)));
      const eva = app.querySelector<HTMLButtonElement>('.eva-zeile')!;
      const antwort = document.getElementById('eva-antwort')!;
      eva.addEventListener('click', () => {
        const offen = eva.getAttribute('aria-expanded') === 'true';
        eva.setAttribute('aria-expanded', String(!offen));
        antwort.hidden = offen;
      });
    }
  </script>

  <Definition frage="Was ist der EVANA Report?" kern={definition.kern} text={definition.text} />

  <section class="sektion sektion-mist">
    <div class="container">
      <div class="kopf">
        <p class="eyebrow">Mehr als Dokumentenablage</p>
        <h2>Aus Ablage wird Überblick</h2>
        <p class="lead">EVANA liest Ihre Dokumente aus und macht daraus einen Objektbericht. Abgelaufene Nachweise, überfällige Prüfungen und Kündigungen erkennt EVANA direkt in den Unterlagen, und zu jedem Befund sehen Sie die Quelle.</p>
      </div>
      <div class="fluss">
        <ul class="ablage">
          {ablage.map((d) => <li class="dok"><DokIcon /><span>{d}</span></li>)}
        </ul>
        <div class="verbindung" aria-hidden="true"><span class="knoten-gross">Bericht</span></div>
        <ul class="befunde">
          {befunde.map((b) => (
            <li>
              <div class="befund-kopf"><span class="art">{b.art}</span><span class={`ton ${b.ton}`}>{b.status}</span></div>
              <strong>{b.titel}</strong>
              <p>{b.text}</p>
              <span class="fundstelle">Quelle: {b.quelle}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="beispiel-hinweis">Beispielhafte Darstellung</p>
    </div>
  </section>

  <section class="sektion">
    <div class="container bereiche-raster">
      <div>
        <p class="eyebrow">Was im Report steht</p>
        <h2>EVANA findet, was fällig ist</h2>
        <p class="lead">Stammdaten, veraltete Nachweise, Mängel aus Wartungs- und Prüfprotokollen, Kündigungen und Fristen: Der Objektbericht liest alles direkt aus Ihren Dokumenten und ordnet es in klare Bereiche.</p>
        <div class="facts" aria-label="Beispiel: Key Facts mit Quelle">
          <p class="facts-titel">Key Facts</p>
          <ul>
            {keyFacts.map((f) => <li><span>{f.label}</span><strong>{f.wert}</strong><span class="fundstelle">Quelle</span></li>)}
          </ul>
          <p class="beispiel-hinweis">Beispielhafte Darstellung</p>
        </div>
      </div>
      <ol class="bereiche">
        {bereiche.map((b) => <li><h3>{b.titel}</h3><p>{b.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sektion auf-dunkel">
    <div class="container portfolio">
      <div>
        <p class="eyebrow">Vom Objekt zum Portfolio</p>
        <h2>Aus Ihren Dokumenten werden Dashboards für das ganze Portfolio</h2>
      </div>
      <div>
        <p class="lead">Sie sehen sofort, wo Fristen, Wartungen oder offene Mängel anstehen, und werten alles direkt mit EVA aus. Neue Dokumente fließen automatisch ein, damit der Report aktuell bleibt.</p>
        <ul class="export" aria-label="Exportformate">
          <li>CSV</li><li>Excel</li><li>API</li>
        </ul>
        <p class="export-text">Exportieren Sie die Daten auf Knopfdruck oder geben Sie sie per API an Ihre BI-Tools weiter.</p>
        <a href={cta.demo} class="btn btn-primaer">Report live sehen</a>
      </div>
    </div>
    <div class="container portfolio-szene">
      <Szene name="report" titel="Interaktives Portfolio-Dashboard: Objekte auswählen und EVA fragen" hinweis="Wählen Sie links ein Objekt aus oder fragen Sie EVA. Beispieldaten." />
    </div>
  </section>

  <section class="sektion sektion-mist">
    <div class="container">
      <div class="kopf">
        <p class="eyebrow">Ein Tool, viele Wege</p>
        <h2>EVANA kann mehr als Dokumente ablegen</h2>
        <p class="lead">Eine Plattform bündelt Ablage, Daten, Report und unsere KI-Assistentin EVA.</p>
      </div>
      <ul class="wege">
        {wege.map((w, i) => (
          <li class:list={{ aktiv: w.aktiv }}>
            <a href={w.href} aria-current={w.aktiv ? 'page' : undefined}>
              <span class="nr">{String(i + 1).padStart(2, '0')}</span>
              <strong>{w.titel}</strong>
              <span>{w.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Anwendungen slugs={['reports-und-fristen', 'dokumente-befragen', 'dokumente-automatisch-ablegen']} titel="Report und Fristen im Alltag" />

  <SicherheitKurz />

  <Faq eintraege={faq} />

  <Abschluss
    titel="Sehen Sie den Report für Ihr eigenes Objekt"
    text="In einer kurzen Demo erstellen wir den Objektbericht aus Ihren Unterlagen und zeigen Ihnen, wo Nachweise fehlen, Anlagen Mängel haben oder Verträge enden."
  />
</Basis>

<style>
  /* Bühne mit großer UI-Szene */
  .buehne { padding-bottom: clamp(56px, 8vw, 104px); background: linear-gradient(180deg, var(--weiss) 0, var(--weiss) 120px, var(--mist) 120px); }
  .app { margin: 0; border-radius: var(--radius-gross); overflow: hidden; background: var(--weiss); box-shadow: 0 40px 90px -40px rgba(0, 67, 79, .45), var(--schatten); }
  .app-kopf { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding: 16px 24px; background: var(--petrol-dunkel); color: #b9d3d8; font-size: .88rem; }
  .krume strong { color: var(--weiss); }
  .stand { margin-left: auto; }
  .knopf { background: var(--magenta); color: var(--weiss); font-weight: 700; font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; border-radius: 8px; padding: 7px 12px; }
  .app-koerper { display: grid; grid-template-columns: 180px minmax(0, 1fr); }
  .seitenmenue { list-style: none; margin: 0; padding: 22px 14px; display: grid; align-content: start; gap: 4px; background: var(--mist); font-size: .9rem; color: var(--hilfsgrau); }
  .seitenmenue li { padding: 9px 12px; border-radius: 10px; }
  .seitenmenue .aktiv { background: var(--tint-magenta); color: var(--magenta); font-weight: 700; }
  .bericht { padding: clamp(18px, 3vw, 30px); display: grid; gap: 18px; }
  .bericht-titel { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .bericht-titel h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); }
  .ton { font-size: .78rem; font-weight: 700; border-radius: 999px; padding: 4px 12px; white-space: nowrap; }
