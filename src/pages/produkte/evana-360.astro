---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Faq from '../../components/Faq.astro';
import Abschluss from '../../components/Abschluss.astro';
import Fenster from '../../components/produkt/Fenster.astro';
import Definition from '../../components/produkt/Definition.astro';
import Funktionen from '../../components/produkt/Funktionen.astro';
import Kennzahlen from '../../components/produkt/Kennzahlen.astro';
import Anwendungen from '../../components/produkt/Anwendungen.astro';
import Referenzen from '../../components/produkt/Referenzen.astro';
import Zitat from '../../components/produkt/Zitat.astro';
import Zusammenspiel from '../../components/produkt/Zusammenspiel.astro';
import SicherheitKurz from '../../components/produkt/SicherheitKurz.astro';
import { cta, zahlen } from '../../data/fakten';
import { brotkrumen, faqSchema, produktSchema, nurGueltig } from '../../lib/schema';

const pfad = [{ label: 'Produkt', href: '/produkte/' }, { label: 'EVANA 360', href: '/produkte/evana-360/' }];

const definition = {
  kern: 'EVANA 360 ist die zentrale Plattform für KI-Dokumentenmanagement in der Immobilienwirtschaft.',
  text: `Sie sammelt sämtliche Unterlagen eines Portfolios in einem Datenraum, klassifiziert sie automatisch in mehr als ${zahlen.dokumenttypen.replace('+', '')} Typen, extrahiert die Inhalte als strukturierte Daten und macht sie über eine globale Suche und die KI-Assistentin EVA sofort nutzbar.`,
};

const treffer = [
  { typ: 'Gewerbemietvertrag', datei: 'Mietvertrag_Stadtwerke_2024.pdf · S. 6', zitat: ['Die Miete ist an den ', 'VPI', ' gekoppelt und wird jährlich nach Veröffentlichung angepasst.'] },
  { typ: 'Nebenkostenabrechnung', datei: 'NK_Abrechnung_2023.pdf · S. 2', zitat: ['Anpassung der ', 'Indexmiete', ' per 01.04.2024, Basis VPI Februar.'] },
  { typ: 'E-Mail-Anhang', datei: 'RE_Mietanpassung.eml · Anhang 1', zitat: ['Beigefügt finden Sie die berechnete ', 'VPI-Anpassung', ' für das laufende Jahr.'] },
];

const weg = [
  { titel: 'Vorher', text: 'Verträge liegen im Postfach, Pläne auf dem Server, Gutachten beim Dienstleister. Alles ist manuell sortiert, schlecht auffindbar und nie ganz aktuell.' },
  { titel: 'Mit EVANA 360', text: `Die Plattform nimmt Unterlagen aus jeder Quelle an, klassifiziert sie automatisch in mehr als ${zahlen.dokumenttypen.replace('+', '')} Typen und legt sie strukturiert ab.` },
  { titel: 'Das Ergebnis', text: 'Globale Suche, Anbindung an SAP und weitere Systeme, Befragung über EVA. Ihr Wissen ist jederzeit verfügbar.' },
];

const merkmale = [
  { titel: 'Automatische Klassifizierung', text: `Mehr als ${zahlen.dokumenttypen.replace('+', '')} Immobilien-Dokumenttypen werden mit ${zahlen.erkennungsrate} Erkennungsrate erkannt, benannt und im richtigen Schema abgelegt. Den Confidence-Threshold stellen Sie selbst ein.` },
  { titel: 'Globale Suche', text: 'Volltext und Inhalte über alle Objekte und Gesellschaften hinweg. Treffer erscheinen direkt mit Fundstelle.' },
  { titel: 'E-Mail-Anhang-Archivierung', text: 'Mails und Anhänge werden automatisch archiviert, ausgelesen und dem passenden Objekt zugeordnet. Die Suche im Postfach entfällt.' },
  { titel: 'Metadaten-Anreicherung', text: 'Aus jedem Dokument werden die zentralen Felder strukturiert extrahiert und dem Objekt als Metadaten hinzugefügt.' },
  { titel: 'Zugriffskontrolle', text: 'Rollen und Rechte granular bis auf Objekt-, Dokument- und Feldebene, mit Strukturen vom Objekt bis zur Gesellschaft. SCIM und SSO sind inklusive, alle Bewegungen werden protokolliert.' },
  { titel: 'Duplikaterkennung', text: 'Mehrfach abgelegte Versionen werden erkannt und sauber zusammengeführt. Der Datenraum bleibt schlank und verlässlich.' },
];

const systeme = [
  { name: 'SAP S/4HANA und RE-FX', zweck: 'Stammdaten- und Vertragsabgleich' },
  { name: 'REST-API', zweck: 'Anbindung an Ihre Systemlandschaft' },
  { name: 'Microsoft 365 und Azure', zweck: 'Office, Outlook, SharePoint' },
  { name: 'Power BI', zweck: 'Reporting auf Bestandsdaten' },
  { name: 'SCIM und SSO', zweck: 'Identitäts- und Rechteverwaltung' },
  { name: 'Individuelle Konnektoren', zweck: 'ERP, CAFM, Buchhaltung' },
];

const rollen = [
  { titel: 'Asset Management', text: 'Portfolioweite Sicht auf Mietverträge, ESG-Daten und Kennzahlen. Sie treffen Bestandsentscheidungen auf gesicherter Datenbasis.' },
  { titel: 'Property und Facility Management', text: 'Wartungs- und Vertragsunterlagen objektbezogen ablegen, Fristen verfolgen und Mängel direkt aus dem Dokument heraus dokumentieren.' },
  { titel: 'Corporate Real Estate', text: 'Den eigenen Bestand zentral abbilden, von der Objekt- bis zur Gesellschaftsebene, mit klaren Zugriffsrechten je Team.' },
  { titel: 'Versicherer und Banken', text: 'Großportfolios kontrolliert verwalten und regulatorische Anforderungen sauber erfüllen, prüfbar bis ins Originaldokument.' },
  { titel: 'Beratung und Prüfung', text: 'Datenräume von Mandanten effizient sichten und auswerten. Die Inhalte liegen strukturiert vor.' },
  { titel: 'Öffentliche Hand', text: 'Liegenschaftsbestände digital konsolidieren und Auskünfte schneller und nachvollziehbar bereitstellen.' },
];

const faq = [
  { frage: 'Was ist EVANA 360?', antwort: `EVANA 360 ist die zentrale Plattform für KI-Dokumentenmanagement in der Immobilienwirtschaft. Sie sammelt sämtliche Unterlagen eines Bestands in einem Datenraum, klassifiziert sie automatisch in mehr als ${zahlen.dokumenttypen.replace('+', '')} Typen, extrahiert die Inhalte als strukturierte Daten und macht sie über eine globale Suche und die KI-Assistentin EVA sofort nutzbar.` },
  { frage: 'Wodurch unterscheidet sich EVANA 360 von einem klassischen DMS?', antwort: 'Ein klassisches DMS dient der Ablage. EVANA 360 erkennt zusätzlich, was in den Dokumenten steht: Eingehende Unterlagen werden automatisch klassifiziert, Inhalte werden als strukturierte Daten extrahiert und Objekte miteinander verknüpft. Aus einer Dokumentenablage wird ein nutzbarer Bestandsdatenraum, der über die globale Suche und die KI-Assistentin EVA direkt befragbar ist.' },
  { frage: 'Wie funktioniert die globale Suche?', antwort: 'Die globale Suche durchläuft sämtliche Inhalte des Datenraums, über Objekte, Gesellschaften und Dokumenttypen hinweg. Sie findet neben Dateinamen auch echte Inhalte wie Klauseln, Werte oder Vermerke. Mit einem Klick öffnen Sie das Originaldokument an der passenden Stelle.' },
  { frage: 'Lässt sich EVANA 360 in SAP und andere bestehende Systeme integrieren?', antwort: 'Ja. EVANA 360 verfügt über eine Standard-Anbindung an SAP RE-FX (S/4HANA) sowie eine offene REST-API, über die sich ERP-, CAFM- und Buchhaltungssysteme andocken lassen. Microsoft 365 und Azure sind ebenso eingebunden wie Power BI für das Reporting. Für Identitäten und Rechte werden SCIM und SSO unterstützt.' },
  { frage: 'Wie kommen die Dokumente in den Datenraum?', antwort: 'Die Dokumente kommen per Massenupload, über bestehende Ordnerstrukturen, automatisch aus E-Mail-Postfächern inklusive Anhängen oder über die REST-API aus angebundenen Systemen in den Datenraum. EVANA AI klassifiziert die Inhalte automatisch, benennt sie konsistent und legt sie strukturiert ab.' },
  { frage: 'Wie werden Zugriffsrechte gesteuert?', antwort: 'EVANA 360 bietet ein granulares Rollen- und Rechtesystem, das bis auf Objekt-, Dokument- und Feldebene reicht. Strukturen vom Einzelobjekt bis zur Gesellschaftsebene lassen sich abbilden. Alle Bewegungen werden protokolliert, Identitäten und Gruppen können über SCIM und SSO an Ihren Identity-Provider angebunden werden.' },
  { frage: 'Wie schnell ist ein bestehender Bestand in EVANA 360 nutzbar?', antwort: 'In der Praxis geht das sehr schnell und schrittweise pro Standort. Ein global tätiger Optik- und Optoelektronik-Konzern hat über zwei Millionen Dokumente in EVANA 360 überführt und die Bearbeitungszeiten um rund 60 Prozent gesenkt. Die KI klassifizierte die Bestände automatisch und entfernte Dubletten, während das bestehende Dateisystem bis zum Abschluss nur Leserechte behielt.' },
  { frage: 'Wie sicher und compliant ist EVANA 360?', antwort: 'EVANA 360 läuft in der EVANA Secure-Cloud. Die Plattform ist ISO 27001-zertifiziert, DSGVO-konform, BaFin-ready und DORA-konform sowie TÜV-geprüft, mit revisionssicherer Ablage gemäß GoBD und jährlichen unabhängigen Penetrationstests. Ihre Dokumente verlassen die geschützte Umgebung nicht.' },
  { frage: 'Wie verhält sich EVANA 360 zu EVANA AI, EVANA TDR und EVA?', antwort: 'EVANA AI ist die KI-Engine darunter, die Klassifizierung und Extraktion liefert. Darauf setzt EVANA 360 als zentraler Bestandsdatenraum auf, der diese Technologie operativ nutzbar macht. Der Transaktionsdatenraum EVANA TDR ergänzt das als Add-on oder eigenständige SaaS, und die KI-Assistentin EVA macht die Inhalte aus EVANA 360 und EVANA TDR in natürlicher Sprache befragbar.' },
];

const schema = nurGueltig([
  produktSchema({ name: 'EVANA 360', beschreibung: `${definition.kern} ${definition.text}`, url: '/produkte/evana-360/' }),
  faqSchema(faq),
  brotkrumen(pfad),
]);
---
<Basis
  title="KI-Dokumentenmanagement für Immobilien | EVANA 360"
  description="EVANA 360 bündelt alle Unterlagen Ihres Bestands in einem Datenraum: automatisch klassifiziert, in Sekunden gefunden und an SAP angebunden."
  schema={schema}
>
  <Seitenkopf
    titel="Ein Datenraum für Ihren gesamten Bestand"
    lead="EVANA 360 ist die Software für Dokumentenmanagement in der Immobilienwirtschaft. Alle Unterlagen Ihres Portfolios liegen an einem Ort, automatisch klassifiziert, sofort durchsuchbar und an Ihre Systeme angebunden."
    pfad={pfad}
    zweitLink={{ label: 'Plattform im Überblick', href: '/produkte/' }}
  />

  <section class="sektion sektion-mist">
    <div class="container such-raster">
      <div>
        <p class="eyebrow">Globale Suche</p>
        <h2>Das eine Dokument aus Millionen, in Sekunden gefunden</h2>
        <p class="lead">EVANA 360 indexiert sämtliche Inhalte des Bestandsdatenraums. Sie suchen über Objekte, Gesellschaften und Dokumenttypen hinweg und springen direkt zur passenden Stelle.</p>
        <p class="absatz">Die Suche findet echte Inhalte wie Klauseln, Werte und Vermerke, zusätzlich zu Dateinamen. Mit einem Klick öffnen Sie das Originaldokument an der richtigen Stelle.</p>
        <a href={cta.demo} class="btn btn-primaer">Suche live sehen</a>
      </div>
      <Fenster titel="EVANA 360 · Suche" meta="412 Treffer in 0,8 Sekunden">
        <div class="suchfeld"><span class="lupe" aria-hidden="true"></span>indexmiete vpi mainufer</div>
        <ul class="treffer">
          {treffer.map((t) => (
            <li>
              <div class="treffer-kopf"><span class="typ">{t.typ}</span><span class="objekt">Bürozentrum Mainufer</span></div>
              <p>„{t.zitat[0]}<mark>{t.zitat[1]}</mark>{t.zitat[2]}“</p>
              <span class="fundstelle">{t.datei}</span>
            </li>
          ))}
        </ul>
      </Fenster>
    </div>
  </section>

  <Definition frage="Was ist EVANA 360?" kern={definition.kern} text={definition.text} />

  <Funktionen
    titel="Aus dem Datenfriedhof wird ein Bestandsdatenraum"
    eintraege={weg}
    variante="schritte"
    mist
  />

  <Funktionen
    eyebrow="Leistungsmerkmale"
    titel="KI-Dokumentenmanagement, das Ihre Unterlagen versteht"
    lead="Klassisches Dokumentenmanagement war Ablage. EVANA 360 aktiviert Ihre Unterlagen und macht sie zur Datenbasis Ihres Portfolios."
    eintraege={merkmale}
  />

  <section class="sektion sektion-mist">
    <div class="container sys-raster">
      <div>
        <p class="eyebrow">Integration</p>
        <h2>EVANA 360 ist SAP-fähig und dockt an Ihre weiteren Systeme an</h2>
        <p class="lead">Stammdaten und Verträge bleiben mit SAP S/4HANA abgeglichen, das Reporting läuft über Power BI, Identitäten laufen über Ihren Identity-Provider. Eine offene REST-API erschließt jedes weitere System.</p>
        <a href="/produkte/integrationen/" class="mehr">Alle Integrationen ansehen</a>
      </div>
      <ul class="systeme">
        {systeme.map((s) => <li><strong>{s.name}</strong><span>{s.zweck}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sektion auf-dunkel">
    <div class="container">
      <div class="kopf">
        <p class="eyebrow">Kunden-Case Corporate Real Estate</p>
        <h2>2 Millionen Dokumente, 60 Prozent schnellere Bearbeitung</h2>
        <p class="lead">Ein global tätiger Optik- und Optoelektronik-Konzern verwaltete über zwei Millionen Dokumente manuell, verteilt über viele Standorte und Gebäude mit teils sechzig Jahren Geschichte. Mit EVANA 360 führte das Unternehmen sein Dokumentenmanagement standortweise neu ein: Die KI klassifizierte die Bestände, entfernte Dubletten und band externe Dienstleister ein.</p>
      </div>
      <Kennzahlen
        dunkel
        eintraege={[
          { wert: '2 Mio.+', label: 'Dokumente strukturiert' },
          { wert: '60 %', label: 'schnellere Bearbeitung' },
          { wert: 'Sekunden', label: 'bis zum richtigen Dokument' },
          { wert: '1', label: 'Datenbasis für alle Standorte' },
        ]}
      />
      <a href="/wissen/dokumentenmanagement-corporate-real-estate/" class="case-link">Ganzen Case lesen</a>
    </div>
  </section>

  <Zitat
    text="Wir sind begeistert von der Benutzerfreundlichkeit von EVANA 360. EVANA kombiniert einen modernen Lebenszyklus-Datenraum mit der fortschrittlichsten künstlichen Intelligenz für die Immobilienbranche."
    person="Nico Schröder"
    rolle="Head of Innovation, Aachener Grundvermögen KVG"
  />

  <Funktionen
    eyebrow="Für wen"
    titel="Wer mit EVANA 360 schneller arbeitet"
    lead="Dokumentenmanagement betrifft viele Rollen zugleich. EVANA 360 bündelt alle Unterlagen so, dass jedes Team genau die Sicht bekommt, die es braucht."
    eintraege={rollen}
    mist
  />

  <Anwendungen slugs={['dokumente-automatisch-ablegen', 'reports-und-fristen', 'dokumente-befragen']} titel="Was Sie mit EVANA 360 erledigen" />

  <Referenzen produkte={['EVANA 360']} titel="EVANA 360 in der Praxis" mist />

  <Zusammenspiel
    aktuell="evana-360"
    titel="EVANA 360 ist der Kern, die anderen Bausteine erweitern ihn"
    lead="Transaktionsdatenraum, Report, Document Router und KI-Assistentin bauen auf der gemeinsamen Engine EVANA AI auf."
    nur={['eva', 'report', 'document-router', 'evana-tdr', 'evana-ai']}
  />

  <SicherheitKurz
    text="EVANA 360 läuft in der EVANA Secure-Cloud auf Microsoft Azure. Die Plattform ist ISO 27001-zertifiziert, DSGVO-konform, BaFin-ready und DORA-konform, mit revisionssicherer Archivierung nach GoBD und jährlichen Penetrationstests durch TÜV Austria."
  />

  <Faq eintraege={faq} />

  <Abschluss
    titel="Sehen Sie EVANA 360 an Ihrem eigenen Bestand"
    text="In einer kurzen Demo führen wir Sie durch Datenraum, globale Suche und Integrationen, mit Bezug zu Ihrer Systemlandschaft."
  />
</Basis>

<style>
  .such-raster { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .such-raster .lead { margin-top: 18px; }
  .absatz { margin-top: 14px; }
  .such-raster .btn { margin-top: 28px; }

  .suchfeld {
    display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 999px;
    background: var(--mist); font-weight: 600; color: var(--headline);
  }
  .lupe { position: relative; flex: none; width: 16px; height: 16px; border-radius: 50%; box-shadow: inset 0 0 0 2.5px var(--petrol); }
  .lupe::after { content: ''; position: absolute; width: 7px; height: 2.5px; background: var(--petrol); right: -5px; bottom: -1px; transform: rotate(45deg); border-radius: 2px; }
  .treffer { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .treffer li { display: grid; gap: 8px; padding: 14px 16px; border-radius: 16px; background: var(--mist); }
  .treffer-kopf { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .82rem; }
  .typ { font-weight: 700; color: var(--petrol); background: var(--tint-petrol); border-radius: 999px; padding: 3px 10px; }
  .objekt { color: var(--hilfsgrau); }
  .treffer p { font-size: .94rem; line-height: 1.45; color: var(--headline); }
  mark { background: var(--tint-orange); color: var(--tint-orange-text); border-radius: 4px; padding: 0 3px; font-weight: 600; }
  .treffer .fundstelle { justify-self: start; background: var(--weiss); }

  .sys-raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .sys-raster .lead { margin-top: 18px; }
  .mehr { display: inline-block; margin-top: 22px; font-weight: 700; }
  .systeme { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .systeme li { display: grid; gap: 2px; padding: 18px 20px; background: var(--weiss); border-radius: 20px; box-shadow: var(--schatten-dokument); }
  .systeme strong { color: var(--petrol-dunkel); }
  .systeme span { font-size: .9rem; color: var(--hilfsgrau); }

  .case-link { display: inline-block; margin-top: 28px; font-weight: 700; color: var(--orange); }
  .case-link:hover { color: var(--weiss); }

  @media (max-width: 900px) { .such-raster, .sys-raster { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .systeme { grid-template-columns: 1fr; } }
</style>
