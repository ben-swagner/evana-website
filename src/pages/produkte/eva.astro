---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Faq from '../../components/Faq.astro';
import Abschluss from '../../components/Abschluss.astro';
import Fenster from '../../components/produkt/Fenster.astro';
import Definition from '../../components/produkt/Definition.astro';
import Funktionen from '../../components/produkt/Funktionen.astro';
import Kennzahlen from '../../components/produkt/Kennzahlen.astro';
import Anwendungen from '../../components/produkt/Anwendungen.astro';
import Referenzen from '../../components/produkt/Referenzen.astro';
import SicherheitKurz from '../../components/produkt/SicherheitKurz.astro';
import { cta, zahlen } from '../../data/fakten';
import { brotkrumen, faqSchema, produktSchema, nurGueltig } from '../../lib/schema';

const pfad = [{ label: 'Produkt', href: '/produkte/' }, { label: 'EVA', href: '/produkte/eva/' }];

const definition = {
  kern: 'EVA ist die KI-Assistentin der EVANA-Plattform, mit der Sie Ihre Immobiliendokumente in natürlicher Sprache befragen.',
  text: `Sie stellen Ihre Frage, EVA durchsucht den gesamten Datenraum in EVANA 360 oder EVANA TDR, antwortet in ${zahlen.evaAntwortzeit} und belegt jede Aussage mit der Fundstelle im Originaldokument.`,
};

const dialog = [
  {
    frage: 'Welche Wartungsmängel sind offen und wie dringend sind sie?',
    antwort: 'Im Protokoll vom 14.03. sind drei Mängel offen. Einer hat hohe Dringlichkeit (Brandschutzklappe, 3. OG), zwei haben mittlere Dringlichkeit.',
    fundstellen: ['Wartungsprotokoll_2025.pdf · S. 7', 'Mängelliste_Q1.pdf · S. 2'],
  },
  {
    frage: 'Gib mir die Verbrauchsdaten der letzten drei Jahre als Tabelle.',
    antwort: 'Gerne. Ich habe die Jahresverbräuche aus Energieausweisen und Abrechnungen zusammengeführt und als Tabelle aufbereitet.',
    fundstellen: ['Energieausweis_2024.pdf · S. 1', 'NK-Abrechnung_2023.pdf · S. 4'],
  },
];

const funktionen = [
  { titel: 'Gezielt fragen', text: 'Sie fragen nach Fristen, Bedingungen oder Mängeln in normaler Sprache und bekommen eine präzise Antwort, ohne ein Dokument zu öffnen.' },
  { titel: 'Sofort verstehen', text: 'EVA fasst lange Verträge und Gutachten in wenigen Sätzen zusammen. So wissen Sie schnell, worum es geht.' },
  { titel: 'Daten auf Knopfdruck', text: 'Verbrauchswerte, Kennzahlen oder Flächen liefert EVA strukturiert als Tabelle, fertig zur Weiterverarbeitung.' },
  { titel: 'Auch aus Bildern', text: 'EVA erkennt Inhalte in Scans, Lageplänen und Fotos und bezieht sie in die Antwort ein.' },
  { titel: 'Immer belegt', text: 'Jede Antwort verweist auf die exakte Stelle im Originaldokument. Sie können jede Aussage selbst prüfen.' },
  { titel: 'Jede Sprache', text: 'Fremdsprachige Unterlagen liefert EVA auf Wunsch konsistent auf Deutsch. Einen Übersetzungsdienst brauchen Sie dafür nicht.' },
];

const katalog = [
  { frage: 'Liegen für alle Mietverträge gültige Unterschriften vor?', treffer: 14 },
  { frage: 'Bestehen offene Wartungsmängel mit hoher Dringlichkeit?', treffer: 3 },
  { frage: 'Sind alle Energieausweise aktuell und gültig?', treffer: 9 },
];

const rollen = [
  { titel: 'Asset Management', text: 'Kennzahlen, Mietverträge und ESG-Daten objektübergreifend abfragen, ohne sich durch Ordner zu klicken.' },
  { titel: 'Property und Facility Management', text: 'Mängel auflisten, Fristen prüfen und Protokolle auswerten. Das gelingt auch mit gescannten Unterlagen.' },
  { titel: 'Transaktion und Due Diligence', text: 'Ganze Fragenkataloge auf den Datenraum anwenden und Risiken früher erkennen, mit Beleg zu jeder Antwort.' },
  { titel: 'Öffentliche Hand', text: 'Große Aktenbestände strukturiert auswerten und Auskünfte schneller und nachvollziehbar bereitstellen.' },
  { titel: 'Beratung und Prüfung', text: 'Mandantenunterlagen effizient sichten, zentrale Fakten extrahieren und sauber belegen.' },
  { titel: 'Corporate Real Estate', text: 'Den eigenen Bestand zentral befragbar machen und Entscheidungen auf belastbare Daten stützen.' },
];

const faq = [
  { frage: 'Was ist die KI-Assistentin EVA?', antwort: 'EVA ist die KI-Assistentin der EVANA-Plattform, mit der Sie Ihre Dokumente mit KI befragen. Sie beantwortet Fragen zu Immobiliendokumenten wie Verträgen, Gutachten und Energieausweisen in natürlicher Sprache, fasst Inhalte zusammen, extrahiert Daten als Tabelle und nennt zu jeder Antwort die Fundstelle im Originaldokument.' },
  { frage: 'Was ist neu in EVA 2.0?', antwort: 'Mit EVA 2.0 lassen sich EVANA-Datenräume erstmals ganzheitlich und dokumentenübergreifend befragen. Sie stellen eine Frage an den gesamten Bestand, und EVA zieht die Antwort aus allen relevanten Unterlagen zusammen.' },
  { frage: 'Kann EVA ganze Fragenkataloge oder Checklisten beantworten?', antwort: 'Ja. Sie übergeben EVA einen kompletten Fragenkatalog, zum Beispiel eine Due-Diligence-Checkliste, und EVA beantwortet jede Frage übergreifend aus dem gesamten Datenraum. Jede Antwort ist mit ihren Fundstellen belegt. So wird aus tagelanger manueller Prüfung ein einziger Durchgang.' },
  { frage: 'Welche Fragen kann ich EVA zu meinen Dokumenten stellen?', antwort: 'Sie können EVA zum Beispiel um eine Zusammenfassung bitten, Verbrauchsdaten als Tabelle extrahieren lassen, Vertragsbedingungen und Fristen prüfen, Wartungsmängel auflisten oder eine Übersetzung anfordern. EVA versteht natürliche Sprache, eine besondere Syntax brauchen Sie nicht.' },
  { frage: 'Zeigt EVA, woher ihre Antworten stammen?', antwort: 'Ja. EVA verweist bei jeder Antwort auf die konkrete Fundstelle im Originaldokument. So lässt sich jede Aussage nachvollziehen und prüfen, was besonders in der Due Diligence und in regulierten Prozessen entscheidend ist.' },
  { frage: 'Wie viel Zeit spare ich mit EVA?', antwort: `Teams sparen mit EVA bis zu ${zahlen.zeitersparnis} ihrer täglichen Arbeitszeit, weil das manuelle Suchen und Auswerten von Dokumenten entfällt. Eine Antwort liegt in ${zahlen.evaAntwortzeit} vor, jede mit Fundstelle belegt.` },
  { frage: 'Ist EVA an ein bestimmtes KI-Modell gebunden?', antwort: 'Nein. EVA ist bewusst offen gestaltet. Sie können Claude, Microsoft Copilot oder Ihr bevorzugtes Sprachmodell an Ihre Immobiliendokumente anbinden. Es gibt keinen Vendor-Lock-in.' },
  { frage: 'Wie sicher sind meine Dokumente mit EVA?', antwort: 'EVA arbeitet in der EVANA Secure-Cloud. Die Plattform ist ISO 27001-zertifiziert, DSGVO-konform, BaFin-ready und DORA-konform sowie TÜV-geprüft und wird durch regelmäßige Audits und Penetrationstests abgesichert. Ihre Dokumente verlassen die geschützte Umgebung nicht.' },
  { frage: 'Für welche Branchen und Rollen ist EVA geeignet?', antwort: 'EVA richtet sich an dokumentenintensive Bereiche der Immobilienwirtschaft: Asset Management, Property und Facility Management, Transaktion und Due Diligence, die öffentliche Hand sowie Beratung und Wirtschaftsprüfung. Sie hilft überall dort, wo viele Dokumente schnell und nachvollziehbar ausgewertet werden müssen.' },
];

const schema = nurGueltig([
  produktSchema({ name: 'EVA', beschreibung: `${definition.kern} ${definition.text}`, url: '/produkte/eva/' }),
  faqSchema(faq),
  brotkrumen(pfad),
]);
---
<Basis
  title="KI-Assistentin EVA: Dokumente mit KI befragen | EVANA"
  description={`Mit EVA befragen Sie Mietverträge, Gutachten und Scans in normaler Sprache. Antwort in ${zahlen.evaAntwortzeit}, jede Aussage mit Fundstelle belegt.`}
  schema={schema}
>
  <Seitenkopf
    titel="EVA kennt Ihre Dokumente und antwortet mit Beleg"
    lead={`EVA ist die KI-Assistentin in Ihren EVANA-Datenräumen. Sie stellen Ihre Fragen zu Verträgen, Gutachten und Scans in ganz normaler Sprache, und EVA liefert die Antwort in ${zahlen.evaAntwortzeit}, belegt mit der Fundstelle.`}
    pfad={pfad}
    zweitLink={{ label: 'Plattform im Überblick', href: '/produkte/' }}
  />

  <section class="sektion sektion-mist szene-sektion">
    <div class="container szene-raster">
      <Fenster titel="EVA · EVANA Datenraum" meta="Objekt: Bürozentrum Mainufer" class="chat-fenster">
        <ol class="chat">
          {dialog.map((d) => (
            <li>
              <p class="frage">{d.frage}</p>
              <div class="antwort">
                <span class="absender"><span class="knoten" aria-hidden="true"></span>EVA</span>
                <p>{d.antwort}</p>
                <div class="chips">{d.fundstellen.map((f) => <span class="fundstelle">{f}</span>)}</div>
              </div>
            </li>
          ))}
        </ol>
        <div class="eingabe" aria-hidden="true"><span>Ihre Frage an EVA</span><i></i></div>
      </Fenster>
      <div class="seitentext">
        <h2>Sie fragen.<br />EVA belegt.</h2>
        <p>Die Antwort steckt in einem von Tausenden Dokumenten. Ihre Teams verwalten pro Objekt Verträge, Protokolle, Gutachten und Scans in vielen Formaten und Sprachen. Mit EVA stellen Sie Ihre Frage einfach in normaler Sprache, und EVA wertet den ganzen Datenraum aus.</p>
        <p>Jede Aussage ist mit der Fundstelle im Originaldokument verknüpft. Sie entscheiden schneller und auf gesicherter Basis.</p>
      </div>
    </div>
  </section>

  <Definition frage="Was ist EVA?" kern={definition.kern} text={definition.text} />

  <section class="zahlen-sektion">
    <div class="container">
      <Kennzahlen
        eintraege={[
          { wert: zahlen.evaAntwortzeit, label: 'bis zur belegten Antwort' },
          { wert: '100 %', label: 'der Antworten mit Fundstelle belegt' },
          { wert: `bis ${zahlen.zeitersparnis}`, label: 'weniger Zeitaufwand, jeden Tag' },
          { wert: zahlen.dokumenttypen, label: 'Dokumenttypen automatisch erkannt' },
        ]}
      />
    </div>
  </section>

  <Funktionen
    eyebrow="Funktionen"
    titel="Dokumente mit KI befragen, statt stundenlang zu suchen"
    lead="EVA übernimmt die Fleißarbeit, die heute Stunden bindet, und Sie gewinnen Zeit für das Wesentliche zurück."
    eintraege={funktionen}
    mist
  />

  <section class="sektion auf-dunkel">
    <div class="container katalog-raster">
      <div>
        <p class="eyebrow">Neu in EVA 2.0</p>
        <h2>EVA beantwortet ganze Fragenkataloge in einer Sitzung</h2>
        <p class="lead">Sie stellen eine Frage an den gesamten Bestand und müssen kein Dokument einzeln öffnen. EVA zieht die Antwort aus allen relevanten Unterlagen zusammen, über Objekt-, Vertrags- und Portfolioebene hinweg.</p>
        <p class="absatz">Übergeben Sie EVA Ihren kompletten Fragenkatalog, zum Beispiel Ihre Due-Diligence-Checkliste. EVA beantwortet jede einzelne Frage übergreifend aus dem gesamten Datenraum. Was früher Tage manueller Prüfung gekostet hat, läuft jetzt in einem Durchgang.</p>
        <a href={cta.demo} class="btn btn-primaer">Checklisten live sehen</a>
      </div>
      <div class="katalog">
        <div class="katalog-kopf">
          <strong>Due-Diligence-Katalog</strong>
          <span>42 Fragen · in einem Durchgang beantwortet</span>
        </div>
        <ul>
          {katalog.map((k) => (
            <li>
              <p>{k.frage}</p>
              <div class="zeile"><span class="status">Beantwortet</span><span class="treffer">{k.treffer} Fundstellen</span></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="container zwei-karten">
      <article class="karte">
        <p class="eyebrow">EVA im Transaktionsdatenraum</p>
        <h2 class="h3">Antwortentwürfe auf Bieterfragen</h2>
        <p>Im Q&A von EVANA TDR formuliert EVA Antwortentwürfe auf Bieterfragen, mit Quelle und in der Sprache der Frage. Gleiche Fragen bekommen konsistente Antworten. Findet EVA nichts Belastbares, sagt sie es offen. Die Freigabe bleibt bei Ihrem Team.</p>
        <a href="/produkte/evana-tdr/" class="mehr">Zu EVANA TDR</a>
      </article>
      <article class="karte">
        <p class="eyebrow">Offene Modellwahl</p>
        <h2 class="h3">Ihr KI-Modell an Ihren Dokumenten</h2>
        <p>Binden Sie Claude, Microsoft Copilot oder Ihr bevorzugtes Sprachmodell direkt an Ihre Immobiliendokumente an. Es gibt keinen Vendor-Lock-in und keine starren Pipelines. Sie behalten die Kontrolle über Modellwahl und Datenfluss.</p>
        <a href="/produkte/integrationen/" class="mehr">Zu den Integrationen</a>
      </article>
    </div>
  </section>

  <Funktionen eyebrow="Für wen" titel="In diesen Bereichen spart EVA Zeit" eintraege={rollen} variante="zeilen" mist />

  <Anwendungen slugs={['dokumente-befragen', 'transaktion-due-diligence', 'reports-und-fristen']} titel="So setzen Kunden EVA ein" />

  <Referenzen produkte={['EVA']} titel="EVA in der Praxis" mist />

  <SicherheitKurz text="EVA arbeitet in der EVANA Secure-Cloud auf Microsoft Azure. Die Plattform ist ISO 27001-zertifiziert, DSGVO-konform, BaFin-ready und DORA-konform. Ihre Dokumente verlassen die geschützte Umgebung nicht." />

  <Faq eintraege={faq} />

  <Abschluss
    titel="Sehen Sie EVA an Ihren eigenen Dokumenten"
    text="In einer kurzen Demo zeigen wir Ihnen, wie viel Zeit EVA Ihrem Team zurückgibt, mit Beleg zu jeder Antwort."
  />
</Basis>

<style>
  .szene-raster { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .seitentext h2 { margin-bottom: 18px; }
  .seitentext p + p { margin-top: 14px; }

  .chat { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .chat li { display: grid; gap: 12px; }
  .frage {
    justify-self: end; max-width: 80%; background: var(--petrol-dunkel); color: var(--weiss);
    border-radius: 18px 18px 4px 18px; padding: 12px 16px; font-weight: 600; line-height: 1.4;
  }
  .antwort { max-width: 92%; background: var(--mist); border-radius: 18px 18px 18px 4px; padding: 14px 16px; }
  .antwort p { line-height: 1.5; }
  .absender { display: inline-flex; align-items: center; gap: 8px; font-size: .78rem; font-weight: 700; letter-spacing: .06em; color: var(--petrol); margin-bottom: 6px; }
  .knoten { width: 10px; height: 10px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(245,158,52,.2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .antwort .fundstelle { background: var(--weiss); }
  .eingabe { margin-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 12px 12px 18px; border-radius: 999px; background: var(--mist); color: var(--hilfsgrau); font-size: .92rem; }
  .eingabe i { width: 34px; height: 34px; border-radius: 50%; background: var(--orange); }

  .zahlen-sektion { padding-bottom: clamp(56px, 8vw, 104px); }

  .katalog-raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .katalog-raster .lead { margin-top: 20px; }
  .absatz { margin-top: 16px; }
  .katalog-raster .btn { margin-top: 30px; }
  .katalog { background: var(--weiss); color: var(--text); border-radius: var(--radius-gross); padding: 28px; box-shadow: 0 30px 80px -30px rgba(0,0,0,.5); }
  .katalog-kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 12px; padding-bottom: 16px; }
  .katalog-kopf strong { color: var(--headline); font-size: 1.1rem; }
  .katalog-kopf span { font-size: .85rem; color: var(--petrol); font-weight: 600; }
  .katalog ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .katalog li { padding: 14px 16px; background: var(--mist); border-radius: 16px; }
  .katalog li p { font-weight: 600; color: var(--headline); line-height: 1.4; }
  .zeile { display: flex; gap: 12px; align-items: center; margin-top: 8px; font-size: .82rem; }
  .status { font-weight: 700; border-radius: 999px; padding: 3px 10px; background: var(--tint-petrol); color: var(--petrol); }
  .treffer { color: var(--hilfsgrau); }
  .katalog .beispiel-hinweis { color: var(--hilfsgrau); }

  .zwei-karten { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .karte { display: flex; flex-direction: column; align-items: flex-start; background: var(--mist); border-radius: var(--radius-gross); padding: clamp(28px, 4vw, 44px); }
  .h3 { font-size: clamp(1.4rem, 2.2vw, 1.8rem); line-height: 1.2; margin-bottom: 14px; }
  .mehr { display: inline-block; margin-top: auto; padding-top: 18px; font-weight: 700; }

  @media (max-width: 900px) {
    .szene-raster, .katalog-raster, .zwei-karten { grid-template-columns: 1fr; }
    .katalog { padding: 20px; }
  }
</style>
